-- Example only -- renamed .sql.example so dbt does not pick it up (scope
-- stops at Phase 9: "write no dbt models"). Rename to .sql once dwh
-- modeling begins. Shows the intended pattern: SCD2 history over a raw_b2b
-- dimension, keyed on the source's own updated_at.
--
-- venues is the one dimension that structurally needs this treatment: the
-- "most popular tickets per region" report groups by venues.region, a
-- mutable attribute, not a stable key -- a plain current-state join would
-- misattribute historical sales if a venue's region were ever corrected.
-- (organizers/customers were removed entirely -- see NOTES.md "Removing
-- organizers and customers" -- and resellers/event_type/ticket_type are
-- used as stable keys or fixed attributes by every report, so none of them
-- need their own SCD2 model; see NOTES.md "Choosing which tables to
-- snapshot" for the full reasoning.)
--
-- {% snapshot venues_snapshot %}
--
-- {{
--     config(
--       target_schema='dwh',
--       unique_key='venue_id',
--       strategy='timestamp',
--       updated_at='updated_at',
--     )
-- }}
--
-- SELECT * FROM {{ source('raw_b2b', 'venues') }}
--
-- {% endsnapshot %}
